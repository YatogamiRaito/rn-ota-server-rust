# ============================================
# React Native OTA Server (Rust) – single .env
# ============================================

# --- Database ---
DATABASE_URL=mysql://root:password@127.0.0.1:3306/ota_server

# --- Server ---
HOST=127.0.0.1
PORT=3010

# --- Apps ---
# Comma-separated list of app names. Each name becomes part of the request path
# (e.g. /main-app/check) and drives the env var suffix below.
# The suffix is the app name upper-cased with every non-alphanumeric character
# replaced by "_":  main-app -> MAIN_APP,  beta.app -> BETA_APP
APPS=main-app,beta-app

# --- Per-app credentials (repeat this block for every name in APPS) ---
AUTH_TOKEN_MAIN_APP=your-secret-token-here
R2_ACCESS_KEY_ID_MAIN_APP=your-access-key
R2_SECRET_ACCESS_KEY_MAIN_APP=your-secret-key
R2_BUCKET_NAME_MAIN_APP=your-bucket-name
# R2_ENDPOINT_MAIN_APP=https://xxxx.r2.cloudflarestorage.com

AUTH_TOKEN_BETA_APP=your-secret-token-here
R2_ACCESS_KEY_ID_BETA_APP=your-access-key
R2_SECRET_ACCESS_KEY_BETA_APP=your-secret-key
R2_BUCKET_NAME_BETA_APP=your-bucket-name
# R2_ENDPOINT_BETA_APP=https://xxxx.r2.cloudflarestorage.com

# --- Shared R2 endpoint (optional fallback for every app) ---
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
