# ============================================
# React Native OTA Server (Rust) – single .env
# ============================================
# Copy to .env and fill in. This configures ONLY the server; your React Native
# app still uses the upstream hot-updater SDK and CLI unchanged:
#   https://github.com/gronxb/hot-updater
# Full reference: https://github.com/ebubekirkaraca/rn-ota-server-rust#configuration

# --- Database ---
DATABASE_URL=mysql://root:password@127.0.0.1:3306/ota_server

# --- Server ---
# Keep HOST on the loopback interface and put a TLS-terminating reverse proxy in
# front of it. Docker sets 0.0.0.0 itself, where the container is the boundary.
HOST=127.0.0.1
PORT=3010

# --- Observability (all optional) ---
# Log filter, standard tracing/env_logger syntax. Unset means:
#   info + warn for the noisy dependencies (sqlx, hyper, the AWS SDK).
# RUST_LOG=info
# Level of the one-line-per-request access log (method, route, status, latency,
# x-request-id). "off" disables request spans entirely — the cheapest hot path.
# One of: off, error, warn, info, debug, trace.
# HTTP_LOG_LEVEL=info
# Serve GET /metrics (Prometheus text format) on the same port. It is unauthenticated
# like /health, so block it at your reverse proxy or set this to false.
# METRICS_ENABLED=true
# Comma-separated CORS origins, or "*" for any. Unset (the default) sends no CORS
# headers at all: the hot-updater SDK and CLI are not browsers and do not need them.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# --- Database connection pool (all optional) ---
# DB_MAX_CONNECTIONS=10
# DB_MIN_CONNECTIONS=2
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=60

# --- Rate limiting (optional, OFF by default) ---
# Applies to the unauthenticated update-check routes only; the CLI API is never
# throttled. Leave this off if your reverse proxy already rate-limits.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_UPDATE_CHECK_PER_SECOND=10
# RATE_LIMIT_UPDATE_CHECK_BURST=20
# Take the client IP from X-Forwarded-For / X-Real-IP / Forwarded instead of the socket
# peer. Only enable when a trusted proxy sets AND overwrites those headers, otherwise
# any client can pick its own rate-limit bucket.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# --- Apps ---
# Comma-separated list of app names. Each name becomes part of the request path
# (e.g. /main-app/check) and drives the env var suffix below.
# The suffix is the app name upper-cased with every non-alphanumeric character
# replaced by "_":  main-app -> MAIN_APP,  beta.app -> BETA_APP
APPS=main-app,beta-app

# --- Per-app credentials (repeat this block for every name in APPS) ---
AUTH_TOKEN_MAIN_APP=your-secret-token-here
R2_ACCESS_KEY_ID_MAIN_APP=your-access-key
R2_SECRET_ACCESS_KEY_MAIN_APP=your-secret-key
R2_BUCKET_NAME_MAIN_APP=your-bucket-name
# R2_ENDPOINT_MAIN_APP=https://xxxx.r2.cloudflarestorage.com

AUTH_TOKEN_BETA_APP=your-secret-token-here
R2_ACCESS_KEY_ID_BETA_APP=your-access-key
R2_SECRET_ACCESS_KEY_BETA_APP=your-secret-key
R2_BUCKET_NAME_BETA_APP=your-bucket-name
# R2_ENDPOINT_BETA_APP=https://xxxx.r2.cloudflarestorage.com

# --- Shared R2 endpoint (optional fallback for every app) ---
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
