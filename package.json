{
  "name": "rn-ota-server-rust",
  "version": "1.0.0",
  "description": "Self-hosted over-the-air update server for React Native apps (hot-updater compatible), written in Rust",
  "license": "MIT",
  "scripts": {
    "dev": "cargo run",
    "build": "cargo build --release",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "lint:fix": "cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged",
    "test": "cargo test"
  }
}
